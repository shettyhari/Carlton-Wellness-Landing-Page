{
  "name": "carlton-wellness-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API and static server for the Carlton Wellness franchise landing page",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "vercel-build": "node -e \"const fs=require('fs');fs.rmSync('public',{recursive:true,force:true});fs.cpSync('../frontend','public',{recursive:true});if(!fs.existsSync('public/index.html'))process.exit(1);console.log('Copied ../frontend to public')\""
  },
  "dependencies": {
    "express": "^4.21.2"
  }
}
