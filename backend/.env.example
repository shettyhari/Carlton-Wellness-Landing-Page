# Copy to backend/.env and adjust. All values are optional.

# Port the server listens on
PORT=3000

# SQLite file for leads (default: database/data/leads.db)
# DB_PATH=/var/lib/carlton-wellness/leads.db

# Folder with index.html, thank-you.html and images (default: ../frontend)
# FRONTEND_DIR=../frontend

# Token required to read leads from GET /api/leads (Authorization: Bearer <token>).
# Leave empty to disable the endpoint.
ADMIN_TOKEN=

# Comma-separated origins allowed to POST leads when the frontend is hosted
# on a different domain (e.g. https://carltonwellness.vercel.app). Leave empty
# when the backend serves the frontend itself.
ALLOWED_ORIGINS=
